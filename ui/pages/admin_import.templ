package pages

import "github.com/openlyfree/gopher-ctf/ui/components"

templ AdminImport() {
 @components.Layout("Bulk import challenges") {
  <div class="admin admin--challenge-create">
   <div class="admin__header">
    <h2>bulk import challenges</h2>
    <a class="admin-nav-button" href="/admin/challenges" hx-boost="false">back to challenges</a>
    <a class="admin-nav-button" href="/admin/challenges/new" hx-boost="false">add one challenge</a>
   </div>
   <section class="admin__card">
    <div class="admin__card-header"><h3>Import JSON</h3></div>
    <form class="admin__form" method="post" action="/admin/challenges/import" hx-post="/admin/challenges/import" hx-encoding="multipart/form-data" hx-target="#upload-result" enctype="multipart/form-data">
     <label class="admin__field"><span>JSON file</span><input type="file" name="import_file" accept=".json,application/json" required/></label>
     <label class="admin__checkbox"><input type="checkbox" name="dry_run"/> <span>dry run</span></label>
     <label class="admin__checkbox"><input type="checkbox" name="update_existing"/> <span>update existing challenges with the same name</span></label>
     <button type="submit">Import challenges</button>
    </form>
    <div id="upload-result" class="admin__result"></div>
   </section>
  </div>
 }
}
