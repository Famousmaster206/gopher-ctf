package pages

import (
	"github.com/openlyfree/gopher-ctf/internal/models"
	"github.com/openlyfree/gopher-ctf/ui/components"
	"strconv"
)

templ Challenges(challenges []models.Challenge, completed map[uint]bool, hideCompleted bool) {
	<div class="challenges-container">
        if hideCompleted {
            <a class="challenge-filter" href="/challenges" hx-get="/challenges" hx-target="main" hx-replace-url="true">show completed</a>
        } else {
            <a class="challenge-filter" href="/challenges?hide_completed=1" hx-get="/challenges?hide_completed=1" hx-target="main" hx-replace-url="true">hide completed</a>
        }
		<div class="challenges-grid">
			for _, c := range challenges {
				<div class="challenge-card" data-completed={ strconv.FormatBool(completed[c.ID]) }>
					<div class="challenge-card-header">
						<h2>{ c.Title }</h2>
						<span class="challenge-points">{ strconv.Itoa(int(c.Points)) } pts</span>
					</div>
					if completed[c.ID] {
                        <p class="challenge-completed">completed! 🔥</p>
                    }
                    <button class="challenge-btn" hx-get={ "/challenges/" + strconv.Itoa(int(c.ID)) } hx-replace-url="true" hx-target="main">View Challenge</button>
				</div>
			}
			if len(challenges) == 0 {
				if hideCompleted {
                    <p class="no-challenges">no unfinished challenges. nice :D</p>
                } else {
                    <p class="no-challenges">No challenges available yet. Check back soon!</p>
                }
			}
		</div>
	</div>
}

templ ChallengesPage(challenges []models.Challenge, completed map[uint]bool, hideCompleted bool) {
	@components.Layout("Challenges") {
		@Challenges(challenges, completed, hideCompleted)
	}
}
