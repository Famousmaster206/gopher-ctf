package pages

import (
 "net/url"
 "strconv"
 "github.com/openlyfree/gopher-ctf/internal/models"
 "github.com/openlyfree/gopher-ctf/ui/components"
)

templ AdminChallenges(challenges []models.Challenge, selected *models.Challenge, message string, query string) {
 @components.Layout("Edit challenges") {
  <div class="admin admin--challenge-editor">
   <div class="admin__header">
    <h2>view &amp; edit challenges</h2>
    <a href="/secret-candy-vault/" hx-boost="false">back to the candy vault</a>
    <p>pick a challenge on the left. change what's needed, then hit save :D</p>
    <p class="admin__hint">save before switching challenges. new points apply to future solves; players keep points they've already earned.</p>
   </div>
   @AdminChallengeWorkspace(challenges,selected,message,query)
  </div>
 }
}

templ AdminChallengeWorkspace(challenges []models.Challenge, selected *models.Challenge, message string, query string) {
 <div id="admin-challenge-workspace" class="admin-challenge-workspace">
  <aside class="admin__card admin-challenge-sidebar" aria-label="Challenges">
   <h3>challenges</h3>
   <form class="admin__form" method="get" action="/admin/challenges" hx-get="/admin/challenges" hx-target="#admin-challenge-workspace" hx-swap="outerHTML" hx-replace-url="true">
    if selected != nil {
     <input type="hidden" name="id" value={ strconv.FormatUint(uint64(selected.ID),10) }/>
    }
    <label class="admin__field"><span>find a challenge</span><input type="search" name="q" value={ query } placeholder="challenge name"/></label>
    <button type="submit">find</button>
   </form>
   <nav class="admin-challenge-list" aria-label="Choose a challenge">
    for _,challenge := range challenges {
     <a class="admin-challenge-link" href={ "/admin/challenges?id="+strconv.FormatUint(uint64(challenge.ID),10)+"&q="+url.QueryEscape(query) } hx-get={ "/admin/challenges?id="+strconv.FormatUint(uint64(challenge.ID),10)+"&q="+url.QueryEscape(query) } hx-target="#admin-challenge-workspace" hx-swap="outerHTML" hx-replace-url="true" aria-current={ strconv.FormatBool(selected!=nil && selected.ID==challenge.ID) }>
      <span>{ challenge.Title }</span>
      <small>#{ strconv.FormatUint(uint64(challenge.ID),10) } ? { strconv.Itoa(challenge.Points) } pts</small>
     </a>
    }
   </nav>
   if len(challenges)==0 {
    if query!="" {
     <p>no matches. try another name?</p>
    } else {
     <p>no challenges yet. add some in the candy vault!</p>
    }
   }
  </aside>
  <section class="admin__card admin-challenge-editor">
   if message!="" {
    <div class="admin__result" role="status">{ message }</div>
   }
   if selected!=nil {
    <h3>{ selected.Title }</h3>
    <form class="admin__form" method="post" action={ "/admin/challenges/"+strconv.FormatUint(uint64(selected.ID),10)+"?q="+url.QueryEscape(query) } hx-boost="false">
     <label class="admin__field"><span>name</span><input type="text" name="challenge_name" value={ selected.Title } required/></label>
     <label class="admin__field"><span>description</span><textarea name="challenge_description" rows="6" required>{ selected.Description }</textarea></label>
     <label class="admin__field"><span>points</span><input type="number" name="challenge_points" min="0" step="1" value={ strconv.Itoa(selected.Points) } required/></label>
     <label class="admin__field"><span>flag (include header)</span><input type="text" name="challenge_flag" value={ selected.Flag } required/></label>
     <button type="submit">save challenge</button>
    </form>
   } else {
    <p>pick a challenge to get started :D</p>
   }
  </section>
 </div>
}
